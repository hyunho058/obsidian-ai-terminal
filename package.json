{
  "name": "obsidian-ai-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian desktop plugin: a terminal panel for Claude Code, Antigravity and a shell, with an Obsidian bridge.",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run && node scripts/test-python.mjs",
    "test:ts": "vitest run",
    "test:py": "node scripts/test-python.mjs",
    "typecheck": "tsc --noEmit",
    "install-plugin": "node scripts/install-plugin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
